require 'json'

xcode_select "/Applications/Xcode.app"

default_platform(:ios)

# Constantes
VERSION = version_get_podspec(path: ENV["podspec_path"])
NEW_VERSION = "_"
SUFFIX = ENV["TYPE"]
APP_NAME= ENV['SCHEME_DEMO']

platform :ios do

  desc "Installed needed provisioning profiles to build and deploy the application."
  lane :install_provisioning_profiles do
    identifier = get_product_bundle_id(project_filepath: ENV['PROJECT_NAME'], scheme: ENV['SCHEME_DEMO'], build_configuration: "Release")

    match(
      type: "adhoc",
      readonly: is_ci,
      team_id: "6PE8U66G2F",
      team_name: "Credit Mutuel Arkea",
      app_identifier: [identifier],
      api_key_path:"/tmp/keys/app-store/arkea-app-store-key.json",
      git_url: "https://gitlark.s.arkea.com/BAD/9057/ios/common/certificates.git"
    )
  end

  desc "Build the framework"
  lane :build do
    gym(
      scheme: ENV["SCHEME"],
      workspace: ENV["WORKSPACE_NAME"],
      sdk: "iphoneos",
      build_path: "./build",
      skip_codesigning: true,
      skip_archive: true,
      derived_data_path: "./DerivedData",
    )
  end

  desc "Execute the unit tests"
  lane :tests do
    scan(
      workspace: ENV["WORKSPACE_NAME"],
      scheme: ENV["SCHEME"],
      skip_build: true,
      reset_simulator:true,
      force_quit_simulator:true,
      disable_concurrent_testing: true,
      code_coverage: true,
      result_bundle: true,
      output_types: "html,junit",
      derived_data_path: "./DerivedData",
      output_directory: "./sonar-reports",
      output_files: "unit-tests-report.html,unit-tests-report.junit",
      devices: ["iPhone 8"],
    )
  end

  desc "Publish the podspec"
  lane :publish do
    # On souhaite enlever toute trace des hooks.
    reset_git_repo(force: true)
   
    # set suffix if dev | rel
    if SUFFIX != ""
      set_suffix
    end
    # Once version has been bumped, checks if tag already exists...
    check_tag
    # ...if not, creates and push the new tag
    create_tag
    # Push updated podspec
    push_podspec
    
  end

  # Check if tag exists and fail
  desc "Check existing tag"
  lane :check_tag do
    # Check if tag for podspec version already exists, if so, we need to fail the pipeline
    if git_tag_exists(tag: VERSION)
      UI.error("Found existing tag ! #{VERSION}") && exit(1)
    end
  end

  desc "Create a git tag"
  lane :create_tag do
    # Create and push new tag
    add_git_tag(tag: VERSION)
    sh "set -e && git push --tags https://"+ ENV['KS501_WRITE_USERNAME'] + ":" + ENV['KS501_WRITE_TOKEN'] + "@gitlab-proxy.arkea.com/bitrise/" + ENV['PROJECT_PATH']
  end

  desc "Push the podspec"
  lane :push_podspec do
    sh "set -e && pod repo add " + ENV['PODSPEC_LOCAL_REPO'] + " " + ENV['PODSPEC_GIT_REPO_URL']
    sh "set -e && pod repo add arkea-bad-9057-ios-podspec-repo https://gitlark.s.arkea.com/BAD/9057/ios/common/ios-podspec-repo.git"
    sh "set -e && pod repo add arkea-bad-9033-ios-podspec-repo https://gitlark.s.arkea.com/BAD/9033/ios-podspec-repo.git"
    # Loop over env var PODSPEC for several podspec files if needed (e.g. IosPhenixResources)
    ENV["PODSPEC"].split(",").map { |podspec|
      begin
        # Get the scheme name based on the podspec name
        scheme = File.basename(podspec.to_s, ".podspec")
        # Push podspec (need to specify private podspec repo, 9033)
        sh "set -e && version=$(git describe --tags) \
        && cd ~/.cocoapods/repos/" + ENV['PODSPEC_LOCAL_REPO'] + " \
        && git reset --hard HEAD \
        && git pull --rebase origin master \
        && mkdir ~/.cocoapods/repos/" + ENV['PODSPEC_LOCAL_REPO'] + "/" + scheme + "/$version \
        && cp ~/git/" + podspec.to_s + " ~/.cocoapods/repos/" + ENV['PODSPEC_LOCAL_REPO'] + "/" + scheme + "/$version/ \
        && git add ~/.cocoapods/repos/" + ENV['PODSPEC_LOCAL_REPO'] + "/" + scheme + "/$version/"+ podspec.to_s + " \
        && git commit -m \"[Update] " + scheme + " ($version)\"\
        && git push https://"+ ENV['KS501_WRITE_USERNAME'] + ":" + ENV['KS501_WRITE_TOKEN'] + "@gitlab-proxy.arkea.com/bitrise/BAD/9057/ios/common/ios-podspec-repo.git"
      rescue => e
        puts e.class
        puts e.message
        UI.error("Could not validate and publish podspec #{VERSION}") && exit(1)
      end

    }
  end


  desc "Set suffix"
  lane :set_suffix do    
    release_version = VERSION[/^\d.+\d+.\d+/]
    "Release version is #{release_version}"

    if SUFFIX == "fix"
        # fetch tag to get last
        sh('git fetch --tags')

        last_tag = last_git_tag(pattern: "#{release_version}-#{SUFFIX}*")
        puts ("Last tag : #{last_tag}")

        if last_tag.nil?
        new_tag_digit = "1"
        puts ("Not Found OLD_VERSION_NAME, new tag is 1")
        else
        # get last digit from tag TYPE and increment ++
        new_tag_digit = last_tag.scan(/\d+/).last.to_i + 1
        puts ("Found OLD_VERSION_NAME, new tag is #{new_tag_digit}")
        end

        NEW_VERSION = "#{release_version}-#{SUFFIX}#{new_tag_digit}"
        puts("Version is now #{NEW_VERSION}")
    elsif SUFFIX == "ftr"
        puts("ftr suffix found")
        NEW_VERSION = "#{release_version}-" + git_branch + "-SNAPSHOT"
    else
        NEW_VERSION = release_version
    end

    # Loop over env var PODSPEC for several podspec files if needed (e.g. IosPhenixResources)
    ENV["PODSPEC"].split(",").map { |podspec|
      # Bump the version in the podspec
      VERSION = version_bump_podspec(path: podspec, version_number: NEW_VERSION)
    }
  end

  desc "Execute Sonar analysis"
  lane :sonarqube do
  ENV['PROJECT_VERSION'] = VERSION
    sonar
  end

  desc "Apply swift linting"
  lane :lint do 
    swiftlint(
      output_file: "./sonar-reports/swiftlint.txt",
      ignore_exit_status: true
    )
  end

  desc "Run swift code validation"
  lane :coverage do 
    slather(
      scheme: ENV["SCHEME"],
      sonarqube_xml: true,
      build_directory: "./DerivedData",
      output_directory: "./sonar-reports",
      workspace: ENV["WORKSPACE_NAME"],
      proj: ENV["PROJECT_NAME"]
    )
  end

  desc "Generate Theme protocols"
  lane :generate_theme_protocols do |options|
    # Needed to use SwiftGen
    branch = git_branch
    puts("branch name: #{branch}")
    # clone iosCoreCommonn
    sh('./generateProtocols.sh', branch)
    # générer via swiftgen
    # supprimer le dépot common
  end

  lane :update_demo_version do
    if NEW_VERSION == "_"
        set_suffix
    end

    increment_version_number_in_plist(
        # specify specific version number (optional, omitting it increments patch version number)
        version_number: "#{NEW_VERSION}",
        target: "#{APP_NAME}" # or `scheme`
    )
  end

    lane :build_demo do
        update_demo_version
        gym(
            configuration: "Release",
            scheme: "#{APP_NAME}",
            output_directory: "buildDemo/",
            output_name: "#{APP_NAME}.ipa",
            build_path: "buildDemo/#{APP_NAME}/",
            archive_path: "archive/#{APP_NAME}/",
            derived_data_path: "./DerivedData",
            export_options: "#{APP_NAME}/Resources/ExportOptions.plist"
        )
    end

    desc "Publish module app-demo on appaloosa..."
    lane :publish_appaloosa do
        generic_appaloosa_store_key = read_json(json_path: "/tmp/keys/appaloosa/generic_appaloosa_store_key.json")
        store_id = generic_appaloosa_store_key[:store_id]
        api_token = generic_appaloosa_store_key[:api_token]
        binary_path = sh("find ../buildDemo/ -name '*.ipa'").sub("../", "./").delete("\n")
        ENV['$BITRISE_IPA_PATH'] = binary_path
        appaloosa(
            binary: binary_path,
            store_id: store_id,
            api_token: api_token,
            group_ids: "22921",
            screenshots: ""
        )        
    end
end
