{
  "cardsV2": [
    {
      "cardId": "review",
      "card": {
        "header": {
          "title": "#author#",
          "subtitle": "#note#",
          "imageUrl": "#avatar#",
          "imageType": "CIRCLE",
          "imageAltText": "Avatar for Sasha"
        },
        "sections": [
          {
            "collapsible": false,
            "widgets": [
              {
                "decoratedText": {
                  "text": "<font color=\"#color#\"><b>Version :</b> #version#</font>",
                  "startIcon": {
                    "iconUrl": "https://cdn-icons-png.flaticon.com/512/10938/10938506.png"
                  }
                }
              },
              {
                "decoratedText": {
                  "text": "<font color=\"#color#\"><b>Version Code :</b> #version_code#</font>",
                  "startIcon": {
                    "iconUrl": "https://cdn-icons-png.flaticon.com/512/4661/4661413.png"
                  }
                }
              },
              {
                "decoratedText": {
                  "text": "<font color=\"#color#\"><b>Téléphone :</b> #phone#</font>",
                  "startIcon": {
                    "iconUrl": "https://cdn-icons-png.flaticon.com/512/12659/12659458.png"
                  }
                }
              },
              {
                "decoratedText": {
                  "text": "<font color=\"#color#\"><b>Commentaire :</b> #comment#</font>",
                  "startIcon": {
                    "iconUrl": "https://cdn-icons-png.flaticon.com/512/8103/8103834.png"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "thread" : { "threadKey":  "#threadId#"}
}
