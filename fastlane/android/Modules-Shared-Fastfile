require 'json'

default_platform(:android)

MODULE= ENV["MODULE"]
SUFFIX = ENV["TYPE"]

PUBLISH_VERSION="_"
OLD_VERSION_NAME="_"
VERSION_NAME="_"
OLD_VERSION_CODE="_"
VERSION_CODE="_"

platform :android do

    before_all do
        read_version_name
    end

    desc "Build module..."
    lane :build do
        # TODO Replace Template by build variant
        gradle(tasks: "assemble --stacktrace")
    end

    desc "Test module..."
    lane :test do
        # TODO Replace Template by build variant
        gradle(tasks: "test --stacktrace")
    end

    desc "Publish module on artifactory..."
    lane :publish_artifactory do
        gradle(task: "publishLibPublicationToArtifactory_bitriseRepository")
    end

    desc "Publish module app-demo on appaloosa..."
    lane :publish_appaloosa do
        generic_appaloosa_store_key = read_json(json_path: "/tmp/keys/appaloosa/generic_appaloosa_store_key.json")
        store_id = generic_appaloosa_store_key[:store_id]
        api_token = generic_appaloosa_store_key[:api_token]
        binary_path = sh("find ../**/**/outputs/apk/release/ -name '*.apk'").sub("../", "./").delete("\n")

        appaloosa(
            binary: binary_path,
            store_id: store_id,
            api_token: api_token,
            group_ids: "22921",
            screenshots: ""
        )        
    end
    
    lane :generate_suffix do
        OLD_VERSION_NAME = VERSION_NAME
        puts("Current SUFFIX is #{SUFFIX}")
        if SUFFIX == "fix" || SUFFIX == "ftr"
            sh('git fetch --tags')

            last_tag = last_git_tag(pattern: "#{VERSION_NAME}-*#{SUFFIX}*")
            puts ("Last tag : #{last_tag}")

            if last_tag.nil?
                new_tag_digit = "1"
                puts ("Not Found OLD_VERSION_NAME, new tag is 1")
            else
                # get last digit from tag TYPE and increment ++
                new_tag_digit = last_tag.scan(/\d+/).last.to_i + 1
                puts ("Found OLD_VERSION_NAME, new tag is #{new_tag_digit}")
            end
            
            if SUFFIX == "ftr"
                PUBLISH_VERSION = "#{VERSION_NAME}-#{git_branch.gsub("/", "_")}-#{SUFFIX}#{new_tag_digit}"
            else
                PUBLISH_VERSION = "#{VERSION_NAME}-#{SUFFIX}#{new_tag_digit}"
            end
        else
            PUBLISH_VERSION = "#{VERSION_NAME}"
        end
            
        puts ("New version : #{PUBLISH_VERSION}")
        write_version_name
    end
    
    lane :update_appdemo_version do
        # update VERSION CODE
        read_version_code
        OLD_VERSION_CODE = VERSION_CODE.to_s
        VERSION_CODE = ENV['BITRISE_BUILD_NUMBER']
        puts ("Test VERSION_CODE , should be BITRISE_BUILD_NUMBER - #{VERSION_CODE}")
        write_version_code
    end

    lane :generate_release_notes_changelog_version do
        sh "cp ~/.cache/fastlane/imported/mobile-indus.git/fastlane/android/ReleaseNote.rb ."
        sh "cd .. ; ruby -r './fastlane/ReleaseNote.rb' -e 'ReleaseNote.new.mainModule'"
        git_commit(path: "./RELEASE_NOTES.md", message: "Generate Release notes" + " [skip ci]")
        git_commit(path: "./CHANGELOG.md", message: "Generate Changelog" + " [skip ci]")

        if SUFFIX == "fix"
            git_commit(path: "./gradle.properties", message: "Update new fix version  #{VERSION_NAME}" + " [skip ci]")
        end

        sh "set -e && git push -o ci.skip https://"+ ENV['KS501_WRITE_USERNAME'] + ":" + ENV['KS501_WRITE_TOKEN'] + "@gitlab-proxy.arkea.com/bitrise/" + ENV['PROJECT_PATH'] + " HEAD:" + ENV['BITRISE_GIT_BRANCH']
    end

    lane :create_tag do
        # Reset gradle.properties update by CI.
        reset_git_repo(
            force: true,
            files: [
                "./gradle.properties"
            ]
        )

        if git_tag_exists(tag: VERSION_NAME)
            UI.error("Found existing tag #{VERSION_NAME}") && exit(1)
        end
        add_git_tag(tag: VERSION_NAME)
        sh "set -e && git push --tags -o ci.skip https://"+ ENV['KS501_WRITE_USERNAME'] + ":" + ENV['KS501_WRITE_TOKEN'] + "@gitlab-proxy.arkea.com/bitrise/" + ENV['PROJECT_PATH']
    end

    #################
    # Private lanes #
    #################

    desc "Read the version code in the gradle.properties file."
    private_lane :read_version_code do
        result = false
        begin
            file = File.new('../gradle.properties', "r")
            while (line = file.gets)
                next unless line.include? 'VERSION_CODE'
                components = line.strip.split(' ')
                result = components[components.length - 1].tr("\"", "")
                break
            end
            file.close
        rescue => err
            UI.error("An exception occurred while reading gradle file: #{err}") && exit(1)
            err
        end
        VERSION_CODE = result
        puts("Current VERSION_CODE is #{VERSION_CODE}")
    end

    desc "Write the version code in the gradle.properties file."
    private_lane :write_version_code do
        file = File.read('../gradle.properties')
        new_content = file.gsub(OLD_VERSION_CODE, VERSION_CODE)
        File.open("../gradle.properties", "w") { |file|
            file.puts new_content 
        }
        puts("Updating old VERSION_CODE #{OLD_VERSION_CODE} to new one  #{VERSION_CODE}")
    end

    desc "Read the version name in the gradle.properties file."
    private_lane :read_version_name do
        result = false
        begin
            file = File.new('../gradle.properties', "r")
            while (line = file.gets)
                next unless line.include? "VERSION_NAME"
                components = line.strip.split(' ')
                result = components[components.length - 1].tr("\"", "")
                break
            end
            file.close
        rescue => err
            UI.error("An exception occured while reading gradle file: #{err}") && exit(1)
            err
        end
        VERSION_NAME = result
        puts("Current VERSION_NAME is #{VERSION_NAME}")
    end

    desc "Write the version name in the gradle.properties file."
    private_lane :write_version_name do
        file = File.read('../gradle.properties')
        new_content = file.gsub(OLD_VERSION_NAME, PUBLISH_VERSION)
        File.open("../gradle.properties", "w") { |file|
            file.puts new_content 
        }
        puts("Updating old VERSION_NAME #{OLD_VERSION_NAME} to new one #{PUBLISH_VERSION}")
    end

end
